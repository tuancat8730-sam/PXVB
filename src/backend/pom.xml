<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>vn.pxvb</groupId>
  <artifactId>pxvb-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>PXVB Parent</name>

  <modules>
    <module>pxvb-building-blocks</module>
    <module>modules/identity</module>
    <module>modules/workflow</module>
    <module>modules/alerting</module>
    <module>modules/dataio</module>
    <module>modules/masterdata</module>
    <module>modules/sync</module>
    <module>modules/planning</module>
    <module>modules/production</module>
    <module>hosts/pxvb-api</module>
    <module>hosts/pxvb-worker</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-modulith.version>1.4.3</spring-modulith.version>
    <uuid-creator.version>6.1.1</uuid-creator.version>
    <bouncycastle.version>1.80</bouncycastle.version>
    <archunit.version>1.3.0</archunit.version>
    <springdoc.version>2.8.13</springdoc.version>
    <poi.version>5.4.0</poi.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>vn.pxvb</groupId>
        <artifactId>pxvb-building-blocks</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>vn.pxvb</groupId>
        <artifactId>pxvb-identity</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>vn.pxvb</groupId>
        <artifactId>pxvb-workflow</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>vn.pxvb</groupId>
        <artifactId>pxvb-alerting</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>vn.pxvb</groupId>
        <artifactId>pxvb-dataio</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>vn.pxvb</groupId>
        <artifactId>pxvb-masterdata</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>vn.pxvb</groupId>
        <artifactId>pxvb-sync</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>vn.pxvb</groupId>
        <artifactId>pxvb-planning</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>vn.pxvb</groupId>
        <artifactId>pxvb-production</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml</artifactId>
        <version>${poi.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.f4b6a3</groupId>
        <artifactId>uuid-creator</artifactId>
        <version>${uuid-creator.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
